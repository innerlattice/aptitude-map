{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/innerlattice/aptitude-map/packages/agents/agent-package.schema.json",
  "title": "Portable agent package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schemaVersion",
    "name",
    "version",
    "description",
    "license",
    "creators",
    "entrypoint",
    "targets",
    "skills",
    "adapter",
    "defaults"
  ],
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "description": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "creators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "name"],
        "properties": {
          "type": { "enum": ["Person", "Organization", "SoftwareAgent"] },
          "name": { "type": "string", "minLength": 1 }
        }
      }
    },
    "entrypoint": { "type": "string", "pattern": "^[^/]+\\.md$" },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind"],
        "properties": { "kind": { "const": "universal" } }
      }
    },
    "skills": {
      "type": "array",
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path", "use"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "path": { "type": "string", "minLength": 1 },
          "use": { "type": "string", "minLength": 1 }
        }
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "requiredCapabilities"],
      "properties": {
        "version": { "const": 1 },
        "requiredCapabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "contract"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z]+(?:[.-][a-z]+)*$" },
              "contract": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "maxActiveWorkItems", "scopeChangePolicy", "stateSchema"],
      "properties": {
        "authority": { "const": "advisory" },
        "maxActiveWorkItems": { "type": "integer", "minimum": 1, "maximum": 7 },
        "scopeChangePolicy": { "const": "approval-required" },
        "stateSchema": { "type": "string", "minLength": 1 }
      }
    }
  }
}
