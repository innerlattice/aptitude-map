{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/innerlattice/aptitude-map/packages/agents/operator/work-state.schema.json",
  "title": "Operator work state",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workId",
    "status",
    "contract",
    "current",
    "decisions",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "workId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["intake", "ready", "active", "verification", "done", "blocked"] },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "evidence", "scope", "nonGoals", "budget", "authority", "currentState"],
      "properties": {
        "outcome": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "minItems": 1, "maxItems": 7, "items": { "type": "string", "minLength": 1 } },
        "scope": { "type": "array", "minItems": 1, "maxItems": 7, "items": { "type": "string", "minLength": 1 } },
        "nonGoals": { "type": "array", "maxItems": 7, "items": { "type": "string", "minLength": 1 } },
        "budget": { "type": "string", "minLength": 1 },
        "authority": { "type": "string", "minLength": 1 },
        "currentState": { "type": "string", "minLength": 1 }
      }
    },
    "current": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activeStep", "nextAction", "blockers", "completedEvidence"],
      "properties": {
        "activeStep": { "type": ["string", "null"] },
        "nextAction": { "type": ["string", "null"] },
        "blockers": { "type": "array", "maxItems": 7, "items": { "type": "string", "minLength": 1 } },
        "completedEvidence": { "type": "array", "maxItems": 7, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["at", "decision", "reason", "authority"],
        "properties": {
          "at": { "type": "string", "format": "date-time" },
          "decision": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "authority": { "type": "string", "minLength": 1 }
        }
      }
    },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
