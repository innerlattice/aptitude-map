{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/innerlattice/aptitude-map/schemas/profile-evidence.schema.json",
  "title": "Profile evidence and calibration claims",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "baselineVersion", "updatedAt", "claims"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "baselineVersion": { "type": "string", "minLength": 1 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "claims": {
      "type": "array",
      "items": { "$ref": "#/$defs/claim" }
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "capabilityIds",
        "claim",
        "confidence",
        "status",
        "contexts",
        "evidence",
        "calibrationPlan"
      ],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "capabilityIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "uniqueItems": true,
          "items": { "type": "string", "format": "uuid" }
        },
        "claim": { "type": "string", "minLength": 1 },
        "confidence": { "enum": ["low", "medium", "high"] },
        "status": { "enum": ["self-reported", "partly-supported", "calibrated", "disconfirmed"] },
        "contexts": {
          "type": "array",
          "maxItems": 7,
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "summary", "reference"],
            "properties": {
              "kind": { "enum": ["artifact", "outcome", "observation", "comparison", "external-feedback"] },
              "summary": { "type": "string", "minLength": 1 },
              "reference": { "type": "string", "minLength": 1 }
            }
          }
        },
        "calibrationPlan": {
          "type": "array",
          "minItems": 1,
          "maxItems": 7,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
